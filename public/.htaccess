# Export statique Next.js (output: "export") — hébergement mutualisé OVH

# Cache long pour les images, vidéos et polices
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|mp4|mov|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /aerial-retreat-lisbon/404.html
